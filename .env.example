# TanAir Cloud Environment Variables
# Copy to .env.local for local development. Configure in Vercel for production.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Hermes AI VPS Gateway Configuration (Server-Only)
# Target production endpoint MUST use HTTPS (e.g. via Cloudflare or Nginx reverse proxy)
# In development, you may use http://localhost:9119
HERMES_GATEWAY_URL=https://gateway.auraone.my

# Optional Shared Secret between TanAir Next.js server and Hermes VPS Gateway
HERMES_GATEWAY_SECRET=your-shared-gateway-secret

# Gateway Timeout in Milliseconds (default: 10000)
HERMES_TIMEOUT_MS=10000

# Set to 'true' only for local offline debugging over insecure HTTP
ALLOW_INSECURE_HERMES_HTTP=false
